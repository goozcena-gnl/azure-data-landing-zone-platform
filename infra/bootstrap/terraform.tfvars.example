# Copy to terraform.tfvars locally. The copied file is ignored by Git.
subscription_id = "00000000-0000-0000-0000-000000000000"
tenant_id       = "00000000-0000-0000-0000-000000000000"
location        = "francecentral"
name_prefix     = "dlzlab"

# Restrict to a trusted public IPv4 address without /32 here.
allowed_ip_addresses = ["203.0.113.10"]

# Optional object ID of a local user/group or GitHub federated service principal.
grant_principal_id = null
