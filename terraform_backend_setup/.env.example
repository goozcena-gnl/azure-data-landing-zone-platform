# Non-sensitive example values only.
# Copy to a local file such as .env.terraform-backend and do not commit
# environment-specific files unless your repository policy explicitly allows it.

export ARM_SUBSCRIPTION_ID="<subscription-id>"
export ARM_TENANT_ID="<tenant-id>"

export TF_BACKEND_PROJECT="platform"
export TF_BACKEND_ENVIRONMENT="dev"
export TF_BACKEND_LOCATION="westeurope"
export TF_BACKEND_RESOURCE_GROUP="rg-platform-dev-tfstate"

# Optional. Leave unset to use the deterministic name generated by the script.
# export TF_BACKEND_STORAGE_ACCOUNT="tfplatformdevxxxxxxxxxx"

export TF_BACKEND_CONTAINER_NAME="tfstate"
export TF_BACKEND_STATE_KEY="dev.tfstate"
export TF_BACKEND_SKU="Standard_LRS"
export TF_BACKEND_NETWORK_MODE="ip"

# Prefer passing a current public IPv4 at runtime or use --detect-client-ip.
# export TF_BACKEND_CLIENT_IP="203.0.113.10"

export TF_BACKEND_BLOB_RETENTION_DAYS="14"
export TF_BACKEND_CONTAINER_RETENTION_DAYS="14"
export TF_BACKEND_FILE="backend.tf"
export TF_BACKEND_CONFIG_FILE="backend.hcl"

# Only required when automatic RBAC assignment cannot resolve the current identity.
# export TF_BACKEND_PRINCIPAL_OBJECT_ID="<principal-object-id>"
# export TF_BACKEND_PRINCIPAL_TYPE="User"

# Terraform backend authentication for a local Azure CLI session.
export ARM_USE_AZUREAD="true"
export ARM_USE_CLI="true"
